# Copy to .env.local (Next.js) AND backend/.env (FastAPI), or export in your shell.
# Server-only. Never prefix secrets with NEXT_PUBLIC_.
BACKEND_URL=http://127.0.0.1:8000
HACKRADAR_API_TOKEN=
XAI_API_KEY=
# Set a model available in your xAI account to enable the optional brief.
XAI_MODEL=
DATABASE_PATH=backend/data/hackradar.sqlite3
